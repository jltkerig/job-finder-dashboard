DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_finder
SEARXNG_SECRET=replace-with-a-long-random-secret

# Optional but recommended: use a long random value for browser session/CSRF signing.
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# Optional: USAJOBS.gov search. Request a free key at developer.usajobs.gov, then fill in both lines.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Optional: Adzuna job search (free for personal use: 250 requests a day). Register at developer.adzuna.com, then fill in both lines.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
